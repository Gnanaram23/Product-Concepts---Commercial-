# Copy to .env (Docker Compose reads it) or set these on your host.
# All are optional: without them the assistant uses the built-in rules engine.

# Any OpenAI-compatible Chat Completions endpoint.
# OpenAI:  LLM_API_KEY=sk-...            (LLM_BASE_URL defaults to https://api.openai.com/v1)
# Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# Ollama:  LLM_BASE_URL=http://ollama:11434/v1           LLM_MODEL=llama3.2   (no key needed)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# PORT=8080
